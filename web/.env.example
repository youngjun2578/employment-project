# true(기본값): 샘플 데이터 사용 + 화면 상단 "샘플 데이터" 배너 표시
# false: data/postings.json (수집기 결과) 사용
NEXT_PUBLIC_USE_SAMPLE=true

# 실제 수집기(live) 전용. 커밋 금지 — .env.local 또는 GitHub Secrets 에만 둘 것
# DATA_GO_KR_KEY=

# 사이트 절대 주소(메타데이터·sitemap). 예: https://example.vercel.app
# NEXT_PUBLIC_SITE_URL=

# 상세 페이지 하단 NCS 수리능력 맛보기 진단 링크 (utm_source=recruit&utm_medium=posting 자동 추가)
# NEXT_PUBLIC_NCS_URL=https://ncsmath.com
